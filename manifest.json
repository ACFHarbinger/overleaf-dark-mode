{
    "name": "Overleaf Dark Mode",
    "description": "A dark mode for the online LaTeX editor Overleaf.",
    "version": "1.64",
    "manifest_version": 3,
    "icons": {
        "48": "img/icon48.png",
        "128": "img/icon128.png"
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "action": {
        "default_title": "Click to toggle dark mode",
        "default_icon": {
            "48": "img/icon48.png",
            "128": "img/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.overleaf.com/*"
            ],
            "js": [
                "toggle.js"
            ]
        }
    ],
    "permissions": [
        "storage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "overleaf-dark-mode@example.com",
            "strict_min_version": "109.0"
        }
    }
}